<Page x:Class="SupaTweaker.Pages.PersonalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <ScrollViewer>
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Персонализация" FontSize="18" FontWeight="SemiBold"/>
                    <CheckBox x:Name="Dark" Content="Тёмная тема приложений"/>
                    <CheckBox x:Name="DarkSys" Content="Тёмная тема системы"/>
                    <CheckBox x:Name="TaskLeft" Content="Выровнять панель задач влево (Win11)"/>
                    <CheckBox x:Name="HideWidgets" Content="Скрыть виджеты на панели задач"/>
                    <CheckBox x:Name="HideChat" Content="Скрыть чат / Copilot на панели"/>
                    <CheckBox x:Name="Trans" Content="Эффекты прозрачности"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Применить" Click="Apply" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
