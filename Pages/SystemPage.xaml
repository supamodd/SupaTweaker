<Page x:Class="SupaTweaker.Pages.SystemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <ScrollViewer>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Система и восстановление" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DockPanel Margin="0,10">
                    <ToggleButton x:Name="Hibernate" Style="{StaticResource Switch}" DockPanel.Dock="Right" Checked="OnToggle" Unchecked="OnToggle"/>
                    <TextBlock Text="Отключить гибернацию (удалит hiberfil.sys)" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <DockPanel Margin="0,10">
                    <ToggleButton x:Name="FastStart" Style="{StaticResource Switch}" DockPanel.Dock="Right" Checked="OnToggle" Unchecked="OnToggle"/>
                    <TextBlock Text="Отключить быстрый запуск" VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel Margin="0,10">
                    <ToggleButton x:Name="UacSoft" Style="{StaticResource Switch}" DockPanel.Dock="Right" Checked="OnToggle" Unchecked="OnToggle"/>
                    <TextBlock Text="Реже спрашивать UAC (не отключать полностью)" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="Точка восстановления" Click="Restore"/>
                    <Button Style="{StaticResource GhostButton}" Content="sysdm.cpl" Click="Sysdm"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
