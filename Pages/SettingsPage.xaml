<Page x:Class="SupaTweaker.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <ScrollViewer>
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Запуск" FontSize="18" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,12">
                        <ToggleButton x:Name="AutoStart" Style="{StaticResource Switch}" DockPanel.Dock="Right" Checked="AutoChanged" Unchecked="AutoChanged"/>
                        <StackPanel>
                            <TextBlock Text="Автоматически запускать при включении ПК" TextWrapping="Wrap"/>
                            <TextBlock Text="В трее, с правами администратора (планировщик заданий)" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="О SupaTweaker" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="Версия 1.0.0 · .NET 8 WPF · Visual Studio Insiders&#x0a;&#x0a;Крестик скрывает в трей. Правый клик по значку — Выход.&#x0a;&#x0a;Активация Windows намеренно отсутствует. Перед массовыми твиками создайте точку восстановления."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
