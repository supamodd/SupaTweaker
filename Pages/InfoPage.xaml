<Page x:Class="SupaTweaker.Pages.InfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent"
      Foreground="{StaticResource BrushText}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}" Padding="0" Height="120" Margin="0,0,0,14">
                <Grid>
                    <Border CornerRadius="18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#243056" Offset="0"/>
                                <GradientStop Color="#12352F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="24,22">
                        <TextBlock Text="ЭТОТ ПК" FontSize="11" FontWeight="Bold" Foreground="#3EE0C6"/>
                        <TextBlock x:Name="PcName" Text="—" FontSize="26" FontWeight="SemiBold" Foreground="#F4F7FF" Margin="0,4,0,0"/>
                        <TextBlock x:Name="OsLine" Text="" Foreground="#C9D2EA" FontSize="13"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl x:Name="Groups">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#F4F7FF" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Foreground="#8B97B3" FontSize="13"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#F4F7FF" FontSize="13" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
