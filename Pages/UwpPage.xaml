<Page x:Class="SupaTweaker.Pages.UwpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Style="{StaticResource GhostButton}" Content="Обновить список" Click="Refresh"/>
            <Button Style="{StaticResource DangerButton}" Content="Удалить выбранные (текущий пользователь)" Click="Remove"/>
        </StackPanel>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Встроенные приложения текущего пользователя" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ListBox x:Name="Apps" SelectionMode="Extended"/>
            </DockPanel>
        </Border>
    </DockPanel>
</Page>
