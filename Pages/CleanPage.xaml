<Page x:Class="SupaTweaker.Pages.CleanPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,10">
                <Grid Height="96">
                    <Border CornerRadius="18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#243056" Offset="0"/>
                                <GradientStop Color="#12352F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="20,14">
                        <TextBlock Text="СКАНИРОВАНИЕ" FontSize="11" FontWeight="Bold" Foreground="#3EE0C6"/>
                        <TextBlock x:Name="JunkTotal" Text="Нажмите «Сканировать»" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        <TextBlock x:Name="JunkLevel" Text="Система + кэши приложений" Foreground="#C9D2EA" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="ScanBtn" Style="{StaticResource PrimaryButton}" Content="Сканировать" Click="ScanClick" Padding="14,6"/>
                <Button x:Name="CleanBtn" Style="{StaticResource GhostButton}" Content="Очистить выбранное" Click="CleanClick" IsEnabled="False" Padding="14,6"/>
            </StackPanel>
            <TextBlock x:Name="SelectedLabel" Text="" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,0,0,8"/>

            <Expander x:Name="SysBox" Style="{StaticResource SectionExpander}" Visibility="Collapsed">
                <Expander.Header>
                    <TextBlock x:Name="SysHeader" Text="Рекомендуемые / система" FontWeight="SemiBold" FontSize="13"/>
                </Expander.Header>
                <ItemsControl x:Name="SysCats">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource JunkRow}">
                                <DockPanel>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" Checked="SelChanged" Unchecked="SelChanged"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="#3EE0C6" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

            <Expander x:Name="AppBox" Style="{StaticResource SectionExpander}" Visibility="Collapsed">
                <Expander.Header>
                    <TextBlock x:Name="AppHeader" Text="Другие элементы приложений" FontWeight="SemiBold" FontSize="13"/>
                </Expander.Header>
                <ItemsControl x:Name="AppCats">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource JunkRow}">
                                <DockPanel>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" Checked="SelChanged" Unchecked="SelChanged"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="#3EE0C6" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="Оперативная память" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RamLabel" Text="ОЗУ: —" FontSize="12" Margin="0,6,0,6"/>
                    <Border Height="8" CornerRadius="4" Background="#1A2438">
                        <Border x:Name="RamBar" Width="0" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource BrushHero}"/>
                    </Border>
                    <Button Style="{StaticResource PrimaryButton}" Content="Очистить ОЗУ" Click="CleanRam" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="14,6"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
