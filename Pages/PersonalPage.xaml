<Page x:Class="SupaTweaker.Pages.PersonalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <ScrollViewer>
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Персонализация" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DockPanel Margin="0,10">
                        <ToggleButton x:Name="Dark" Style="{StaticResource Switch}" DockPanel.Dock="Right" Checked="OnToggle" Unchecked="OnToggle"/>
                        <TextBlock Text="Тёмная тема приложений" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,10">
                        <ToggleButton x:Name="DarkSys" Style="{StaticResource Switch}" DockPanel.Dock="Right" Checked="OnToggle" Unchecked="OnToggle"/>
                        <TextBlock Text="Тёмная тема системы" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,10">
                        <ToggleButton x:Name="Trans" Style="{StaticResource Switch}" DockPanel.Dock="Right" Checked="OnToggle" Unchecked="OnToggle"/>
                        <TextBlock Text="Эффекты прозрачности" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,10">
                        <ToggleButton x:Name="HideWidgets" Style="{StaticResource Switch}" DockPanel.Dock="Right" Checked="OnToggle" Unchecked="OnToggle"/>
                        <TextBlock Text="Скрыть виджеты на панели задач" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,10">
                        <ToggleButton x:Name="HideChat" Style="{StaticResource Switch}" DockPanel.Dock="Right" Checked="OnToggle" Unchecked="OnToggle"/>
                        <TextBlock Text="Скрыть чат / Copilot на панели" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Значки панели задач" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Выравнивание (Windows 11)" Foreground="{StaticResource BrushMuted}" Margin="0,4,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="AlignLeft" Style="{StaticResource Seg}" Content="Влево" GroupName="align" Checked="AlignChanged"/>
                        <RadioButton x:Name="AlignCenter" Style="{StaticResource Seg}" Content="По центру" GroupName="align" Checked="AlignChanged"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
