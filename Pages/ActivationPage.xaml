<Page x:Class="SupaTweaker.Pages.ActivationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- статус-карточка -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,10">
                <Grid>
                    <Border CornerRadius="18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#243056" Offset="0"/>
                                <GradientStop Color="#12352F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="20,16">
                        <TextBlock Text="АКТИВАЦИЯ WINDOWS" FontSize="11" FontWeight="Bold" Foreground="#3EE0C6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#8B97B3"
                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="StatusBig" Text="Проверка статуса…" FontSize="22"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusSub" Text="Запрос лицензионного состояния (slmgr /xpr)…"
                                   Foreground="#C9D2EA" FontSize="12" Margin="20,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="EditionLine" Text="" Foreground="#C9D2EA" FontSize="12"
                                   Margin="20,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="EditionWarning" Visibility="Collapsed" TextWrapping="Wrap"
                       Foreground="{StaticResource BrushDanger}" FontSize="12" Margin="0,0,0,10"
                       Text="Внимание: ключ W269N-WFGWX-YVC9B-4J6C9-T83GX подходит для редакций Pro / Pro for Workstations / Education. На редакции Home активация не пройдёт — нужна лицензия Pro."/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="ActivateBtn" Style="{StaticResource PrimaryButton}"
                        Content="Активировать Windows" Click="ActivateClick"
                        Padding="22,10" FontSize="14"/>
                <Button x:Name="RefreshBtn" Style="{StaticResource GhostButton}"
                        Content="Обновить статус" Click="RefreshClick" Padding="14,6"/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Журнал активации" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,2,0,10"
                               Text="Одной кнопкой: установить ключ → указать KMS-сервер компании → активировать. Требуется запуск от имени администратора и доступ к kms.supamoddcomp.ir (порт 1688, TCP)."/>
                    <Border Background="{StaticResource BrushInput}" CornerRadius="10" Padding="12">
                        <TextBox x:Name="Log" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 FontSize="12.5" Foreground="#D7E3FF" CaretBrush="#D7E3FF"
                                 IsReadOnlyCaretVisible="False"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 MinHeight="150" MaxHeight="260"/>
                    </Border>
                    <TextBlock x:Name="HintLine" Text="" Visibility="Collapsed" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
