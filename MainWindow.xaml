<Window x:Class="SupaTweaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SupaTweaker" Height="760" Width="1200"
        MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        FontFamily="{DynamicResource AppFont}"
        Foreground="{StaticResource BrushText}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="18" Background="#FF080B14" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ambient glow -->
            <Ellipse Grid.Column="1" Width="420" Height="420" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-140,-80,0" Opacity="0.22" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#6C8CFF" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Grid.Column="1" Width="360" Height="360" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-40,0,0,-120" Opacity="0.16" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3EE0C6" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Border Grid.Column="0" Background="{StaticResource BrushPane}" CornerRadius="18,0,0,18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="22,20,18,6"
                                MouseLeftButtonDown="Title_Drag">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrushHero}">
                                <TextBlock Text="S" FontWeight="Bold" FontSize="18" Foreground="#061018"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SUPATWEAKER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccent2}"/>
                                <TextBlock Text="Windows studio" FontSize="12" Foreground="{StaticResource BrushMuted}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border x:Name="AdminChip" Margin="0,16,0,8" Padding="10,6" CornerRadius="20" Background="#1A3DDC97" HorizontalAlignment="Left">
                            <TextBlock x:Name="AdminBadge" Text="нужны права администратора" FontSize="11" Foreground="{StaticResource BrushOk}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="10,6,10,16">
                        <RadioButton Style="{StaticResource NavButton}" Content="  Настройки" Tag="settings" GroupName="nav" Click="Nav_Click"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="РАЗДЕЛЫ" Margin="24,8,0,6" FontSize="11" Foreground="#5E6B88" FontWeight="SemiBold"/>
                            <RadioButton Style="{StaticResource NavButton}" Content="  Главная" Tag="home" GroupName="nav" IsChecked="True" Click="Nav_Click"/>
                            <RadioButton Style="{StaticResource NavButton}" Content="  Проводник" Tag="explorer" GroupName="nav" Click="Nav_Click"/>
                            <RadioButton Style="{StaticResource NavButton}" Content="  Windows Update" Tag="update" GroupName="nav" Click="Nav_Click"/>
                            <RadioButton Style="{StaticResource NavButton}" Content="  Система" Tag="system" GroupName="nav" Click="Nav_Click"/>
                            <RadioButton Style="{StaticResource NavButton}" Content="  Персонализация" Tag="personal" GroupName="nav" Click="Nav_Click"/>
                            <RadioButton Style="{StaticResource NavButton}" Content="  UWP приложения" Tag="uwp" GroupName="nav" Click="Nav_Click"/>
                            <RadioButton Style="{StaticResource NavButton}" Content="  Быстрая настройка" Tag="quick" GroupName="nav" Click="Nav_Click"/>
                            <RadioButton Style="{StaticResource NavButton}" Content="  Дополнительно" Tag="adv" GroupName="nav" Click="Nav_Click"/>
                            <RadioButton Style="{StaticResource NavButton}" Content="  Компоненты" Tag="comp" GroupName="nav" Click="Nav_Click"/>
                            <RadioButton Style="{StaticResource NavButton}" Content="  Производительность" Tag="perf" GroupName="nav" Click="Nav_Click"/>
                            <RadioButton Style="{StaticResource NavButton}" Content="  Таймер выключения" Tag="sat" GroupName="nav" Click="Nav_Click"/>
                            <RadioButton Style="{StaticResource NavButton}" Content="  Процессы" Tag="proc" GroupName="nav" Click="Nav_Click"/>
                            <RadioButton Style="{StaticResource NavButton}" Content="  Автозагрузка" Tag="startup" GroupName="nav" Click="Nav_Click"/>
                            <RadioButton Style="{StaticResource NavButton}" Content="  О системе" Tag="info" GroupName="nav" Click="Nav_Click"/>
                            <RadioButton Style="{StaticResource NavButton}" Content="  Очистка" Tag="clean" GroupName="nav" Click="Nav_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid MouseLeftButtonDown="Title_Drag" Background="Transparent">
                    <TextBlock Text="SupaTweaker" VerticalAlignment="Center" Margin="28,0,0,0"
                               Foreground="#6B7690" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource CaptionBtn}" Content="—" Click="Min_Click"/>
                        <Button Style="{StaticResource CloseBtn}" Content="✕" Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <DockPanel Grid.Row="1" Margin="28,4,28,10">
                    <TextBlock x:Name="PageTitle" Text="Главная" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource BrushText}"/>
                    <TextBlock x:Name="PageSub" Text="Добро пожаловать в SupaTweaker"
                               VerticalAlignment="Bottom" Margin="14,0,0,5" Foreground="{StaticResource BrushMuted}"/>
                </DockPanel>

                <Frame x:Name="ContentHost" Grid.Row="2" NavigationUIVisibility="Hidden" Margin="20,0,20,8"
                       Background="Transparent"
                       TextElement.Foreground="{StaticResource BrushText}"
                       TextElement.FontFamily="{DynamicResource AppFont}"/>

                <Border Grid.Row="3" Padding="28,10" Background="#66070A12">
                    <DockPanel>
                        <Ellipse Width="7" Height="7" Fill="{StaticResource BrushAccent2}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="Готово" Foreground="{StaticResource BrushMuted}" FontSize="12"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
