<Page x:Class="SupaTweaker.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}" Padding="0" Height="168">
                <Grid>
                    <Border CornerRadius="18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2A3A78" Offset="0"/>
                                <GradientStop Color="#12352F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="26,24">
                        <TextBlock Text="SUPATWEAKER · 0.3" FontSize="12" FontWeight="Bold" Foreground="#3EE0C6"/>
                        <TextBlock Text="Различные полезные твики для Windows, и не только." FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock Width="520" TextWrapping="Wrap" Foreground="#C9D2EA"
                                   Text="Персонализация, производительность и уборка без лишнего шума. Активация Windows не входит в программу."/>
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Columns="3">
                <Border Style="{StaticResource Card}" Margin="0,0,10,12">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="10" Background="#286C8CFF" HorizontalAlignment="Left">
                            <TextBlock Text="⚡" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Быстрый старт" FontWeight="SemiBold" FontSize="16" Margin="0,12,0,4"/>
                        <TextBlock Text="Готовый набор твиков для свежей системы на странице «Быстрая настройка»." Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,12">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="10" Background="#283EE0C6" HorizontalAlignment="Left">
                            <TextBlock Text="🛡" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Безопасность" FontWeight="SemiBold" FontSize="16" Margin="0,12,0,4"/>
                        <TextBlock Text="Перед крупными правками создайте точку восстановления в разделе «Система»." Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="10" Background="#28FF5C7A" HorizontalAlignment="Left">
                            <TextBlock Text="✦" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Оптимизация" FontWeight="SemiBold" FontSize="16" Margin="0,12,0,4"/>
                        <TextBlock Text="В разработке..." Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</Page>
