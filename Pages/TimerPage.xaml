<Page x:Class="SupaTweaker.Pages.TimerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="Таймер выключения" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Минуты до действия" Foreground="{StaticResource BrushMuted}" Margin="0,10,0,4"/>
            <TextBox x:Name="Mins" Text="30" Width="120" HorizontalAlignment="Left"/>
            <ComboBox x:Name="Action" Width="240" HorizontalAlignment="Left" SelectedIndex="0">
                <ComboBoxItem Content="Выключение"/>
                <ComboBoxItem Content="Перезагрузка"/>
            </ComboBox>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Style="{StaticResource PrimaryButton}" Content="Запустить" Click="Start"/>
                <Button Style="{StaticResource GhostButton}" Content="Отменить" Click="Cancel"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Page>
