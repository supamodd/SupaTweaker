<Page x:Class="SupaTweaker.Pages.CleanPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Оперативная память" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushMuted}" Margin="0,6,0,12"
                               Text="Обрезает рабочий набор процессов, сбрасывает кэш файловв и список ожидания. Кэш потом наберётся снова — это нормально."/>
                    <TextBlock x:Name="RamLabel" Text="ОЗУ: —" FontSize="14" Margin="0,0,0,8"/>
                    <Border Height="10" CornerRadius="5" Background="#1A2438">
                        <Border x:Name="RamBar" Width="0" HorizontalAlignment="Left" CornerRadius="5" Background="{StaticResource BrushHero}"/>
                    </Border>
                    <Button Style="{StaticResource PrimaryButton}" Content="Очистить ОЗУ" Click="CleanRam" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Файлы" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DockPanel Margin="0,10">
                        <ToggleButton x:Name="Temp" Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="True"/>
                        <TextBlock Text="Папка %TEMP%" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,10">
                        <ToggleButton x:Name="Prefetch" Style="{StaticResource Switch}" DockPanel.Dock="Right"/>
                        <TextBlock Text="Prefetch (осторожно)" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,10">
                        <ToggleButton x:Name="Recycle" Style="{StaticResource Switch}" DockPanel.Dock="Right"/>
                        <TextBlock Text="Корзина" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Button Style="{StaticResource GhostButton}" Content="Очистить выбранное" Click="Go" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
