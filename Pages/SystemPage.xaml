<Page x:Class="SupaTweaker.Pages.SystemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <ScrollViewer>
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Система и восстановление" FontSize="18" FontWeight="SemiBold"/>
                    <CheckBox x:Name="Hibernate" Content="Отключить гибернацию (удалит hiberfil.sys)"/>
                    <CheckBox x:Name="FastStart" Content="Отключить быстрый запуск"/>
                    <CheckBox x:Name="UacSoft" Content="Снизить частоту запросов UAC (не отключать полностью)"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Применить" Click="Apply"/>
                        <Button Style="{StaticResource GhostButton}" Content="Точка восстановления" Click="Restore"/>
                        <Button Style="{StaticResource GhostButton}" Content="sysdm.cpl" Click="Sysdm"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
