<Page x:Class="SupaTweaker.Pages.CleanPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid Height="132">
                    <Border CornerRadius="18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#243056" Offset="0"/>
                                <GradientStop Color="#12352F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="24,20">
                        <TextBlock Text="СКАНИРОВАНИЕ" FontSize="11" FontWeight="Bold" Foreground="#3EE0C6"/>
                        <TextBlock x:Name="JunkTotal" Text="Нажмите «Сканировать»" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock x:Name="JunkLevel" Text="PC Manager-стиль: кэши, корзина, обновления, дампы" Foreground="#C9D2EA"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="ScanBtn" Style="{StaticResource PrimaryButton}" Content="Сканировать" Click="ScanClick"/>
                <Button x:Name="CleanBtn" Style="{StaticResource GhostButton}" Content="Очистить выбранное" Click="CleanClick" IsEnabled="False"/>
            </StackPanel>
            <TextBlock x:Name="SelectedLabel" Text="" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,8"/>

            <ItemsControl x:Name="Cats">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,12">
                            <DockPanel>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" Checked="SelChanged" Unchecked="SelChanged"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#3EE0C6" Margin="12,0,0,0"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Hint}" Foreground="{StaticResource BrushMuted}" FontSize="12"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Оперативная память" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushMuted}" Margin="0,6,0,12"
                               Text="Обрезает working set, file cache и standby list."/>
                    <TextBlock x:Name="RamLabel" Text="ОЗУ: —" FontSize="14" Margin="0,0,0,8"/>
                    <Border Height="10" CornerRadius="5" Background="#1A2438">
                        <Border x:Name="RamBar" Width="0" HorizontalAlignment="Left" CornerRadius="5" Background="{StaticResource BrushHero}"/>
                    </Border>
                    <Button Style="{StaticResource PrimaryButton}" Content="Очистить ОЗУ" Click="CleanRam" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
